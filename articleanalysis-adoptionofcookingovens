# Définir la taille de l'échantillon
n_sample1 <- 500
# Sélectionner aléatoirement les identifiants uniques pour l'échantillon
sample1_Nr <- sample(unique(new_household_data$hhid_M), size = n_sample1)
# Filtrer les données pour inclure uniquement les individus de l'échantillon
sample_1 <- filter(new_household_data, hhid_M %in% sample1_Nr)
# Créer une variable "treated1" qui attribue aléatoirement le traitement (0 ou 1) à chaque individu
treatment_sample1 <- mutate(sample_1, treated1 = sample(c(0, 1), size = n_sample1, replace = TRUE))
# Calculer la moyenne de la variable "Scaste_tribe_BL" pour le groupe traité (lottery = 1)
mean_scaste_traitement <- mean(treatment_sample1$Scaste_tribe_BL[treatment_sample1$Lottery1 == 1], na.rm = TRUE)
0.4428571
# Calculer la moyenne de la variable "Scaste_tribe_BL" pour le groupe témoin (lottery = 0)
mean_scaste_controle <- mean(treatment_sample1$Scaste_tribe_BL[treatment_sample1$Lottery1 == 0], na.rm = TRUE)
0.3866171
#conclusion avec un echantillon de 500 on remarque une légère difference entre les deux groupes

